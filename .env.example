SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Leave any collection blank to skip that size/group without changing its recommendations.
TWIN_MATTRESS_COLLECTION=
TWIN_XL_MATTRESS_COLLECTION=
FULL_MATTRESS_COLLECTION=
QUEEN_MATTRESS_COLLECTION=
KING_MATTRESS_COLLECTION=
CALIFORNIA_KING_MATTRESS_COLLECTION=
SPLIT_KING_MATTRESS_COLLECTION=
SPLIT_CALIFORNIA_KING_MATTRESS_COLLECTION=

TWIN_ADJUSTABLE_BASE_COLLECTION=
TWIN_XL_ADJUSTABLE_BASE_COLLECTION=
FULL_ADJUSTABLE_BASE_COLLECTION=
QUEEN_ADJUSTABLE_BASE_COLLECTION=
KING_ADJUSTABLE_BASE_COLLECTION=
CALIFORNIA_KING_ADJUSTABLE_BASE_COLLECTION=
SPLIT_KING_ADJUSTABLE_BASE_COLLECTION=
SPLIT_CALIFORNIA_KING_ADJUSTABLE_BASE_COLLECTION=

ALLOW_SHOPIFY_WRITE=false
# Preserve existing recommendations when zero candidates remain. Set clear to write [].
EMPTY_RECOMMENDATIONS=preserve
SIZE_OPTION_NAMES=Size,Mattress Size,Bed Size
